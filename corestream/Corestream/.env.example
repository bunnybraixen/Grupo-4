# =====================================================================
# Variables de entorno para el docker-compose.yml de la raíz (producción)
# =====================================================================
# Copiar a ".env" en este mismo directorio y rellenar con valores reales
# ANTES de levantar los contenedores. Este fichero (.env) nunca debe llegar
# al repositorio — ya está en .gitignore — y en la VM debería vivir con
# permisos restringidos (chmod 600) fuera del árbol si es posible.
#
# backend/.env y frontend/.env son para desarrollo local SIN Docker; este
# docker-compose.yml no los lee — todo lo que el backend necesita se le
# pasa aquí, en la sección "environment" de cada servicio.
# =====================================================================

# -----------------------------------------------------------------------
# Puertos publicados en 0.0.0.0, igual que el resto de proyectos de esta
# VM (no hay Nginx local — el enrutamiento público lo gestiona algo fuera
# de esta máquina). 8010 en vez de 8000 porque otro proyecto de la VM ya
# usa 8000. Ver docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=8080

# -----------------------------------------------------------------------
# PostgreSQL y Redis: NO son contenedores propios en producción — esta VM
# ya tiene ambos corriendo, compartidos con otros proyectos (contenedores
# db-postgre y directa-redis-1). CoreStream usa su propia base/usuario
# dentro de esa misma instancia de Postgres — ver docs/DEPLOYMENT.md para
# cómo crearlos. redis:// sin autenticación porque esa instancia no tiene
# contraseña configurada; el aislamiento real lo dan los prefijos
# "corestream:" en claves y canales (ver app/redis_client.py).
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://corestream:CAMBIAR-en-.env@10.0.0.19:5432/corestream
REDIS_URL=redis://10.0.0.19:6379/5

# -----------------------------------------------------------------------
# Autenticación (backend)
# -----------------------------------------------------------------------
# Generar con: openssl rand -hex 32 — el arranque ABORTA si esto no cambia
# y ENVIRONMENT=production (ver app/config.py, validate_production_settings).
SECRET_KEY=cambiar-esta-clave-por-una-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
APP_NAME=CoreStream API

# Dominio real desde el que se sirve el frontend. Sin esquema duplicado ni
# barra final. Con ENVIRONMENT=production, ALLOWED_ORIGINS con "*" aborta
# el arranque (no se puede combinar con allow_credentials=True).
ALLOWED_ORIGINS=https://corestream.alloxentric.com

# IP(s) desde las que se acepta X-Forwarded-For / X-Forwarded-Proto. "*"
# (confiar en cualquiera) es razonable acá: esta VM no es alcanzable
# directamente desde internet, solo desde la red privada. Se puede afinar
# más adelante a la IP real del proxy externo si se llega a conocer — no
# es un bloqueante. Ver docs/DEPLOYMENT.md.
FORWARDED_ALLOW_IPS=*

# Número de procesos de uvicorn — ajustar a los núcleos de la VM.
UVICORN_WORKERS=4

# -----------------------------------------------------------------------
# Traducción de documentos (Azure Cognitive Services) — opcional. Si se
# deja vacío, la función de traducir documentos se desactiva limpiamente
# (no da 502, ver plan fase 8).
# -----------------------------------------------------------------------
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

# -----------------------------------------------------------------------
# Frontend (solo en tiempo de build; Vite las incrusta en el bundle)
# -----------------------------------------------------------------------
# Vacío = usar '/api' (correcto cuando el mismo Nginx sirve front y proxya
# /api hacia el backend, que es el caso previsto). Solo cambiar si el
# frontend se sirve desde un dominio distinto al del backend.
VITE_API_BASE_URL=
