# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
# URL de conexión a PostgreSQL con driver async (asyncpg)
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+asyncpg://corestream:corestream@localhost:5432/corestream

# ==========================================
# CONFIGURACIÓN DE REDIS
# ==========================================
# URL de conexión al servidor Redis
# Formato: redis://[:contraseña]@host:puerto/db
# Ejemplo con contraseña: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ==========================================
# CONFIGURACIÓN DE AUTENTICACIÓN Y SEGURIDAD
# ==========================================
# Clave secreta para firmar tokens JWT
# IMPORTANTE: Generar una clave segura en producción con: openssl rand -hex 32
SECRET_KEY=qU_U2N2qXvtDU6C6R_2lScIn9XV8jxY42alaGZTsr0A

# Algoritmo criptográfico para tokens JWT (recomendado: HS256)
ALGORITHM=HS256

# Tiempo de expiración del token de acceso en minutos
# Ejemplo: 30 minutos para seguridad mejorada
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tiempo de expiración del token de refresco en días
# Ejemplo: 7 días para facilitar re-autenticación sin perder sesión
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CONFIGURACIÓN DE CORS
# ==========================================
# Orígenes permitidos para solicitudes CORS desde el frontend
# Separar múltiples orígenes con comas: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=["http://localhost:5173"]

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
# Nombre de la aplicación (se muestra en documentación OpenAPI)
APP_NAME=CoreStream API

# Modo debug
# IMPORTANTE: Desactivar en producción (DEBUG=False)
# En desarrollo: DEBUG=True activa recarga automática y errores detallados
DEBUG=True

# ==========================================
# CONFIGURACIÓN OPCIONAL DE LOGGING
# ==========================================
# Nivel de log: debug, info, warning, error, critical
# LOG_LEVEL=info

# ==========================================
# CONFIGURACIÓN OPCIONAL DE EMAIL (futuro)
# ==========================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu-contraseña-aplicación

# ==========================================
# CONFIGURACIÓN OPCIONAL DE STORAGE (futuro)
# ==========================================
# S3_BUCKET=corestream-uploads
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
