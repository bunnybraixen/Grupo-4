# Configuración de Entorno para CoreStream Frontend

# ========================================
# DESARROLLO
# ========================================

# Puerto del servidor de desarrollo Vite
VITE_PORT=5173

# URL base de la API (HTTP y WebSocket, ver services/api.ts y
# composables/useWebSocket.ts). Relativa a propósito: tanto en dev (proxy
# de Vite) como en producción (nginx) el backend cuelga del mismo origen
# que el frontend, bajo /api — no hay subdominio de API separado.
VITE_API_BASE_URL=/api

# ========================================
# PRODUCCIÓN
# ========================================

# URL pública de la aplicación en producción
VITE_PUBLIC_URL=https://corestream.example.com

# ========================================
# CARACTERÍSTICAS
# ========================================

# Habilitar soporte de análitica
VITE_ANALYTICS_ENABLED=true

# Clave de analytics (si se usa servicio externo)
VITE_ANALYTICS_KEY=

# Habilitar notificaciones por email
VITE_EMAIL_NOTIFICATIONS=true

# ========================================
# DEBUG
# ========================================

# Nivel de log (debug, info, warn, error)
VITE_LOG_LEVEL=info

# Mostrar detalles de API en consola
VITE_DEBUG_API=false
